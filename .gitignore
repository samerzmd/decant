# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# Diff images written when a golden test fails.
/test/failures/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing — never commit the upload keystore or its passwords.
android/key.properties
*.jks
*.keystore

# Python (asset generation scripts in tool/)
__pycache__/
*.egg-info/
.venv/
venv/

# NOTE: assets/sounds/*.wav and branding/*.png are intentionally committed —
# they are the shipped, generated source assets (regenerable via tool/).


# Firebase config — generated per project by `flutterfire configure`; kept out
# of this public repo (see README → Firebase).
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
firebase.json

# fvm: local symlink to the pinned Flutter SDK (version lives in .fvmrc)
.fvm/
